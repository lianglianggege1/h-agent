# 复制为 .env 后填写。不要提交真实密钥。

# 主对话模型（必填）
API_KEY=
MODEL_NAME=
# AgentScope 使用的 Anthropic 兼容地址；通常无需修改。
ANTHROPIC_BASE_URL=https://api.minimaxi.com/anthropic

# 本地基础设施
DB_URL=jdbc:postgresql://127.0.0.1:5432/h_agent_db?currentSchema=skill_platform,public
DB_USERNAME=h_agent
DB_PASSWORD=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0
JWT_SECRET=
JWT_EXPIRATION_SECONDS=7200

# MiniMax：语音/视频共用；图片可单独覆盖
MINIMAX_BASE_URL=https://api.minimaxi.com
MINIMAX_API_KEY=
IMAGE_BASE_URL=https://api.minimaxi.com
IMAGE_API_KEY=
IMAGE_MODEL_NAME=image-01
# 以下图片参数均可省略
# IMAGE_ASPECT_RATIO=1:1
# IMAGE_PROMPT_OPTIMIZER=true
# IMAGE_COUNT=1
# IMAGE_REQUEST_TIMEOUT_SECONDS=180
TAVILY_API_KEY=

# MinIO 对象存储
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_RESOURCES_BUCKET=h-agent-resources
# 可选：Skill 制品使用独立账号或 Bucket
# MINIO_SKILLS_ACCESS_KEY=
# MINIO_SKILLS_SECRET_KEY=
# MINIO_SYSTEM_SKILLS_BUCKET=h-agent-skills
# MINIO_USER_SKILLS_BUCKET=h-agent-skills

# Gitee Skill 仓库
GITEE_TOKEN=

# Langfuse（整组留空即关闭观测导出）
LANGFUSE_BASE_URL=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Mem0（memory.long-term.enabled=true 时必填全部四项）
MEM0_BASE_URL=http://localhost:8888
MEM0_API_KEY=
MEM0_CONTRACT_VERSION=
MEM0_OPENAPI_SHA256=
