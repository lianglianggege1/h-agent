# LiveKit connection (required)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# LangChain model provider (required for the default OpenAI model)
OPENAI_API_KEY=

# h-agent integration
BACKEND_API_BASE_URL=http://127.0.0.1:8081
VOICE_AGENT_NAME=h-agent-realtime-voice

# FastAPI endpoint for frontend integration
VOICE_API_HOST=127.0.0.1
VOICE_API_PORT=8090

# Worker health endpoint; do not reuse the Spring Boot 8081 port
VOICE_HEALTH_HOST=127.0.0.1
VOICE_HEALTH_PORT=8091

# Realtime pipeline models
VOICE_LLM_MODEL=openai:gpt-4.1-mini
VOICE_STT_MODEL=deepgram/nova-3
VOICE_TTS_MODEL=cartesia/sonic-3
VOICE_TTS_VOICE=9626c31c-bec5-4cca-baa8-f8ba9e84c8bc
