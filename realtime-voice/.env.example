# LiveKit worker registration (internal URL may use ws:// on the trusted LAN)
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=replace-me
LIVEKIT_API_SECRET=replace-with-at-least-32-characters
VOICE_AGENT_NAME=h-agent-voice

# Java control plane; keep this endpoint off the browser-facing proxy.
JAVA_VOICE_URL=http://127.0.0.1:8081
VOICE_WORKER_TOKEN=replace-with-at-least-32-random-characters

# Fixed provider for v1
HUOSHAN_ASR_API_KEY=
HUOSHAN_ASR_RESOURCE_ID=volc.seedasr.sauc.duration
HUOSHAN_ASR_WS_URL=wss://openspeech.bytedance.com/api/v3/sauc/bigmodel_async
HUOSHAN_TTS_API_KEY=
HUOSHAN_TTS_RESOURCE_ID=seed-icl-2.0
HUOSHAN_TTS_MODEL=seed-tts-2.0-standard
HUOSHAN_TTS_WS_URL=wss://openspeech.bytedance.com/api/v3/tts/bidirection
# Must be a voice authorized for this account. No private reference-project voice is copied.
HUOSHAN_TTS_SPEAKER=
