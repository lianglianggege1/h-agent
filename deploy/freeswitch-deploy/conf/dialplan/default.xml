<include>
  <context name="default">

    <!-- 内部分机互拨：1000 <-> 1001 -->
    <extension name="internal_extensions">
      <condition field="destination_number" expression="^(100[01])$">
        <action application="set" data="call_timeout=30"/>
        <action application="bridge" data="user/${1}@${domain}"/>
      </condition>
    </extension>

  </context>
</include>
