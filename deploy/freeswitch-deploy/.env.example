# FreeSWITCH 配置（个人本地开发环境）
# 复制为 .env 后按需修改：cp .env.example .env

# ESL
ESL_PORT=8021
# drachtio 镜像默认 ESL 密码为 ClueCon；如需修改需覆盖 event_socket.conf.xml
ESL_PASSWORD=ClueCon

# SIP
SIP_PORT=5060

# RTP 媒体端口段（开发用收窄到 17 个端口，足够单通通话）
RTP_PORT_START=16384
RTP_PORT_END=16400

# 内存上限
FS_MEM_LIMIT=512m

# 测试分机密码（与 conf/directory/default/*.xml 中的 password 对应）
EXTENSION_1000_PASSWORD=1000
EXTENSION_1001_PASSWORD=1001
