# 复制为 .env 后填入真实值：cp .env.example .env
# 密钥生成方式：
#   NACOS_AUTH_TOKEN=$(openssl rand -base64 48)
#   NACOS_AUTH_IDENTITY_KEY=$(openssl rand -hex 8)
#   NACOS_AUTH_IDENTITY_VALUE=$(openssl rand -hex 16)

# 宿主机侧控制台端口（容器内固定 8080，勿用 NACOS_CONSOLE_PORT 这个名字）
NACOS_CONSOLE_HOST_PORT=8081

# Base64 且解码后 >32 字节，否则 Nacos 拒绝启动
NACOS_AUTH_TOKEN=
NACOS_AUTH_IDENTITY_KEY=
NACOS_AUTH_IDENTITY_VALUE=

NACOS_AUTH_ENABLE=false

JVM_XMS=512m
JVM_XMX=512m
JVM_XMN=256m
NACOS_MEM_LIMIT=1g
