port: 7880
bind_addresses:
  - "0.0.0.0"
rtc:
  tcp_port: 7881
  use_external_ip: false
  # Replace with the LiveKit host's stable LAN address.
  node_ip: 192.168.1.20
  udp_port: 7882
keys:
  replace-api-key: replace-with-at-least-32-characters
webhook:
  api_key: replace-api-key
  urls:
    - http://192.168.1.10:8081/internal/livekit/webhook
logging:
  level: info
